// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <1>; };

/ {

    macros {
        lto_a: lto_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &to 0>
                , <&macro_press &kp A>
                , <&macro_pause_for_release>
                , <&macro_release &kp A>
                ;
        };
    };

    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <500>;
            bindings = <&lto_a &to 1 &to 2>;
        };
    };

    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &rgb_ug RGB_TOG &td0
            >;

            sensor-bindings = <
            &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
///////////////////////////////////
        fn_layer {
            bindings = <
            &rgb_ug RGB_EFF &td0
            >;

            sensor-bindings = <
            &inc_dec_kp LEFT RIGHT
            >;
        };
////////////////////////////////////
        extra1 { 
            bindings = <
            &studio_unlock &td0
            >;

            sensor-bindings = <
            &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        extra2 { 
            status = "reserved"; }
            ;
    };
};
